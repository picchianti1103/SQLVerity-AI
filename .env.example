# Development-only bootstrap credential. Replace it before starting SQLVerity AI.
# The value must contain at least 32 characters.
SQLVERITY_BOOTSTRAP_API_KEY=change-this-development-bootstrap-key-123456

# Native development path. Compose overrides it with a persistent /data path.
SQLVERITY_CATALOG_PATH=sqlverity_catalog.sqlite3
SQLVERITY_CATALOG_BACKEND=postgresql
SQLVERITY_EXTRAS=postgres,openai,identity,secrets,observability
SQLVERITY_PORT=8000

# Compose PostgreSQL catalog plus a separate synthetic database with a SELECT-only login.
SQLVERITY_POSTGRES_DB=sqlverity
SQLVERITY_POSTGRES_USER=sqlverity
SQLVERITY_POSTGRES_PASSWORD=change-this-development-postgres-password
SQLVERITY_DEMO_DB_PASSWORD=change-this-read-only-demo-password
SQLVERITY_CATALOG_POOL_MIN_SIZE=1
SQLVERITY_CATALOG_POOL_MAX_SIZE=10
SQLVERITY_SECRET_BACKENDS=environment
SQLVERITY_REQUIRE_PROVIDER_POLICY=true
# Shared HMAC key for short-lived, actor/context-bound AI transfer confirmations.
# Production deployments must inject a random value of at least 32 bytes.
SQLVERITY_PREFLIGHT_SIGNING_KEY=change-this-preflight-signing-key-1234567890
SQLVERITY_PREFLIGHT_TTL_SECONDS=300
SQLVERITY_RATE_WINDOW_SECONDS=60
SQLVERITY_USER_REQUESTS_PER_WINDOW=60
SQLVERITY_USER_MAX_CONCURRENT=4
SQLVERITY_TENANT_REQUESTS_PER_WINDOW=300
SQLVERITY_TENANT_MAX_CONCURRENT=20
SQLVERITY_DATA_SOURCE_REQUESTS_PER_WINDOW=120
SQLVERITY_DATA_SOURCE_MAX_CONCURRENT=8
SQLVERITY_PROVIDER_HTTP_MAX_ATTEMPTS=3
SQLVERITY_PROVIDER_HTTP_RETRY_BASE_SECONDS=0.25
SQLVERITY_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
SQLVERITY_PROVIDER_CIRCUIT_RECOVERY_SECONDS=30
SQLVERITY_BACKGROUND_WORKER_ENABLED=true
SQLVERITY_BACKGROUND_WORKER_POLL_MILLISECONDS=1000
SQLVERITY_BACKGROUND_JOB_LEASE_SECONDS=120
SQLVERITY_SEMANTIC_INFERENCE_BATCH_SIZE=50

# Optional OpenTelemetry traces. Use an HTTPS OTLP/HTTP collector in production.
# SQLVERITY_OTEL_ENABLED=true
# SQLVERITY_OTEL_TRACE_SAMPLE_RATIO=0.1
# SQLVERITY_OTEL_ALLOW_INSECURE=false
# OTEL_SERVICE_NAME=sqlverity-api
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.internal:4318

# Production secret backends can be enabled explicitly. Database secret refs
# then use vault://mount/path or aws-secretsmanager://secret-id.
# SQLVERITY_SECRET_BACKENDS=vault,aws-secrets-manager
# VAULT_ADDR=https://vault.example.internal
# VAULT_TOKEN=inject-a-short-lived-token
# AWS_REGION=eu-south-1

# Optional OIDC/SSO. Subjects must first be provisioned in the tenant; account
# recovery and MFA enrollment remain the responsibility of the identity provider.
# SQLVERITY_OIDC_ISSUER=https://login.example.com/realms/sqlverity
# SQLVERITY_OIDC_AUDIENCE=sqlverity-api
# SQLVERITY_OIDC_JWKS_URL=https://login.example.com/realms/sqlverity/protocol/openid-connect/certs
# SQLVERITY_OIDC_TENANT_CLAIM=sqlverity_tenant_id
# SQLVERITY_OIDC_REQUIRE_MFA=true
# SQLVERITY_OIDC_REQUIRED_ACR=
# SQLVERITY_OIDC_AUTHORIZATION_ENDPOINT=https://login.example.com/authorize
# SQLVERITY_OIDC_TOKEN_ENDPOINT=https://login.example.com/token
# SQLVERITY_OIDC_CLIENT_ID=sqlverity-console
# SQLVERITY_OIDC_CLIENT_SECRET=load-from-the-deployment-secret-store
# SQLVERITY_OIDC_REDIRECT_URI=https://sqlverity.example.com/auth/oidc/callback
# SQLVERITY_BROWSER_SESSION_SECRET=replace-with-at-least-32-random-characters
# SQLVERITY_BROWSER_SECURE_COOKIES=true

# LLM providers are disabled unless explicitly selected. Uncomment one block.
# Configure either the singular selector or the plural selector, never both.
# SQLVERITY_LLM_PROVIDERS=ollama,openai,anthropic,gemini,kimi
# SQLVERITY_LLM_PROVIDER=ollama
# SQLVERITY_OLLAMA_MODEL=qwen2.5-coder:7b
# Native: http://127.0.0.1:11434
# Compose: http://host.docker.internal:11434 (enabled by the Compose-only bridge opt-in)
# SQLVERITY_OLLAMA_BASE_URL=http://127.0.0.1:11434
# A separate container/private host requires an approved HTTPS endpoint and:
# SQLVERITY_OLLAMA_ALLOW_REMOTE=true

# SQLVERITY_LLM_PROVIDER=openai
# OPENAI_API_KEY=replace-with-a-secret-manager-value
# SQLVERITY_OPENAI_MODEL=replace-with-an-approved-model-id
# SQLVERITY_OPENAI_DATA_RESIDENCY=eu
# SQLVERITY_OPENAI_RETENTION_MODE=zero
# SQLVERITY_OPENAI_DEPLOYMENT_TYPE=external_cloud

# SQLVERITY_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-with-a-secret-manager-value
# SQLVERITY_ANTHROPIC_MODEL=replace-with-an-approved-model-id
# SQLVERITY_ANTHROPIC_DATA_RESIDENCY=unspecified
# SQLVERITY_ANTHROPIC_RETENTION_MODE=provider_default
# SQLVERITY_ANTHROPIC_DEPLOYMENT_TYPE=external_cloud

# SQLVERITY_LLM_PROVIDER=gemini
# GEMINI_API_KEY=replace-with-a-secret-manager-value
# SQLVERITY_GEMINI_MODEL=replace-with-an-approved-model-id
# SQLVERITY_GEMINI_DATA_RESIDENCY=unspecified
# SQLVERITY_GEMINI_RETENTION_MODE=provider_default
# SQLVERITY_GEMINI_DEPLOYMENT_TYPE=external_cloud

# SQLVERITY_LLM_PROVIDER=kimi
# MOONSHOT_API_KEY=replace-with-a-secret-manager-value
# SQLVERITY_KIMI_MODEL=replace-with-an-approved-model-id
# SQLVERITY_KIMI_DATA_RESIDENCY=unspecified
# SQLVERITY_KIMI_RETENTION_MODE=provider_default
# SQLVERITY_KIMI_DEPLOYMENT_TYPE=external_cloud

# Example PostgreSQL connection secret for local development only. The catalog
# stores env://SQLVERITY_DEMO_DB, never the JSON value below.
# SQLVERITY_DEMO_DB={"host":"host.docker.internal","port":5432,"database":"analytics","username":"sqlverity_reader","password":"replace-me","sslmode":"prefer"}
